{
  "name": "trading-journal",
  "version": "0.1.0",
  "private": true,
  "description": "Trading Journal - 주식 매매일지",
  "scripts": {
    "dev": "pnpm --filter web dev & pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm --recursive build",
    "build:web": "pnpm --filter web build",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive type-check",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:push": "pnpm --filter api prisma:push"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}

