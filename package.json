{
  "name": "stock-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Stock Market Dashboard - 주식 시장 요약 대시보드",
  "scripts": {
    "dev": "pnpm --filter stock dev & pnpm --filter api start:dev",
    "dev:stock": "pnpm --filter stock dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm --recursive build",
    "build:stock": "pnpm --filter stock build",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive type-check",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:push": "pnpm --filter api prisma:push"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}

