generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum IncomeCategory {
  event
  survey
  experience
}

model Income {
  id        String         @id @default(uuid())
  category  IncomeCategory
  date      String         // YYYY-MM-DD format
  amount    Int
  memo      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([date])
  @@index([category])
}

// ==================== Stock Market Models ====================

enum MarketType {
  KOSPI
  KOSDAQ
}

enum MoverType {
  GAINER
  LOSER
}

enum InvestorType {
  FOREIGN
  INSTITUTION
}

// 시장 지수
model MarketIndex {
  id            String     @id @default(uuid())
  date          String     // YYYY-MM-DD
  market        MarketType
  closePrice    Int        // 종가
  change        Int        // 전일대비
  changePercent Float      // 등락률 (%)
  volume        BigInt     // 거래량
  tradingValue  BigInt     // 거래대금 (억원)
  createdAt     DateTime   @default(now())

  @@unique([date, market])
  @@index([date])
}

// 섹터 등락
model SectorPerformance {
  id            String   @id @default(uuid())
  date          String
  sectorName    String
  changePercent Float
  createdAt     DateTime @default(now())

  @@unique([date, sectorName])
  @@index([date])
}

// 거래량 상위 종목
model TopVolumeStock {
  id            String     @id @default(uuid())
  date          String
  rank          Int
  stockCode     String
  stockName     String
  closePrice    Int
  change        Int
  changePercent Float
  volume        BigInt
  marketCap     BigInt     // 시가총액 (원)
  market        MarketType
  createdAt     DateTime   @default(now())

  @@unique([date, market, rank])
  @@index([date])
}

// 급등/급락 종목
model StockMover {
  id            String     @id @default(uuid())
  date          String
  type          MoverType
  rank          Int
  stockCode     String
  stockName     String
  closePrice    Int
  change        Int
  changePercent Float
  volume        BigInt
  marketCap     BigInt     // 시가총액 (원)
  market        MarketType
  createdAt     DateTime   @default(now())

  @@unique([date, market, type, rank])
  @@index([date])
  @@index([type])
}

// 투자자별 매매 동향
model InvestorTrading {
  id           String       @id @default(uuid())
  date         String
  investorType InvestorType
  market       MarketType
  buyAmount    BigInt       // 매수금액 (억원)
  sellAmount   BigInt       // 매도금액 (억원)
  netAmount    BigInt       // 순매수금액 (억원)
  createdAt    DateTime     @default(now())

  @@unique([date, market, investorType])
  @@index([date])
}

// 거래대금 상위 종목
model TopTradingValueStock {
  id            String     @id @default(uuid())
  date          String
  rank          Int
  stockCode     String
  stockName     String
  closePrice    Int
  change        Int
  changePercent Float
  tradingValue  BigInt     // 거래대금 (백만원)
  marketCap     BigInt     // 시가총액 (원)
  market        MarketType
  createdAt     DateTime   @default(now())

  @@unique([date, market, rank])
  @@index([date])
}

// 주식 뉴스
model StockNews {
  id          String   @id @default(uuid())
  date        String
  stockCode   String
  stockName   String
  title       String
  url         String
  source      String
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@unique([date, stockCode, url])
  @@index([date])
  @@index([stockCode])
}
